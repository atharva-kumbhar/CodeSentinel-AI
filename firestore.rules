rules_version = '2';

/**
 * Firestore Security Rules — PR Review Assistant
 * ─────────────────────────────────────────────
 * Deploy these rules via:
 *   firebase deploy --only firestore:rules
 *
 * Security model:
 * - Users can only read/write their own data (users/{uid})
 * - The private subcollection (GitHub tokens) is admin-only
 * - The backend (Admin SDK) bypasses these rules — it has full access
 * - Frontend only reads reviews/repos/settings for real-time subscriptions
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles (Root Collection) ──────────────────────────
    match /users/{uid} {
      // Users can read/write only their own document
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // ── Private subcollection (encrypted GitHub tokens) ────────
      // NEVER readable from the frontend — Admin SDK only
      match /private/{document=**} {
        allow read, write: if false;  // Backend Admin SDK bypasses this
      }
    }

    // ── Repositories (Root Collection) ────────────────────────────
    match /repositories/{repoId} {
      allow read:  if request.auth != null && resource.data.connected_user == request.auth.uid;
      // Writes go through the backend API (which validates GitHub ownership)
      allow write: if false;
    }

    // ── Reviews / Review History (Root Collection) ────────────────
    match /review_history/{reviewId} {
      allow read:  if request.auth != null && resource.data.connected_user == request.auth.uid;
      // Reviews are written by the backend Admin SDK only
      allow write: if false;
    }

    // ── Deny everything else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
