# Backend Environment Variables — PR Review Assistant
# Copy this file to .env and fill in your actual values

# ═══════════════════════════════════════════════════════════════════
# NVIDIA NIM API KEY  (required for default AI reviews)
═══════════════════════════════════════════════════════════════════
NVIDIA_API_KEY=

# NVIDIA NIM Endpoint & Model (defaults — change only if needed)
NVIDIA_BASE_URL=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ═══════════════════════════════════════════════════════════════════
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback

# Session signing key — MUST be changed in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Frontend URL (used to redirect after OAuth login/logout)
FRONTEND_URL=http://localhost:5173

# ═══════════════════════════════════════════════════════════════════
# GITHUB TOKEN  (optional — server-side fallback for anonymous access)
# ───────────────────────────────────────────────────────────────────
# Used as a fallback if no OAuth session exists and no token in request.
# Scopes: public_repo (public repos) or repo (private repos)
# Create at: https://github.com/settings/tokens
# ═══════════════════════════════════════════════════════════════════
GITHUB_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# GITHUB WEBHOOK SECRET  (required for secure webhook verification)
# ───────────────────────────────────────────────────────────────────
#
# Webhook setup: GitHub repo → Settings → Webhooks → Add webhook
#   Payload URL:     https://your-backend.com/api/review/webhook
#   Content type:    application/json
#   Secret:          (paste your WEBHOOK_SECRET here)
#   Events:          Pull requests
# ═══════════════════════════════════════════════════════════════════
WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
# The private key contains newlines — use \n escape or quotes:
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID_SA=
FIREBASE_CLIENT_CERT_URL=
#
# Token encryption key for GitHub tokens stored in Firestore.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIREBASE_TOKEN_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═══════════════════════════════════════════════════════════════════
APP_NAME=PR Review Assistant
ENV=development
DEBUG=true

ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# AI Tuning
MAX_DIFF_TOKENS=12000
MAX_CHUNK_SIZE=4000
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
